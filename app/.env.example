# ============================================================
# PILOTE RESEAU — Secrets SERVEUR UNIQUEMENT (jamais dans le front)
# Copiez ce fichier en ".env" et remplissez chaque ligne.
# Guide complet : ../06_Checklist_configuration_et_mise_en_ligne.md
# ============================================================

# --- 1. IA (obligatoire pour le vrai modele) ---
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# --- 2. Meta / Facebook / Instagram / WhatsApp (obligatoire reseaux reels) ---
META_APP_ID=
META_APP_SECRET=
META_VERIFY_TOKEN=choisissez-un-mot-secret-long
META_REDIRECT_URI=https://VOTRE-DOMAINE/auth/meta/callback
WHATSAPP_TOKEN=

# --- 2b. TikTok commentaires (optionnel) ---
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REDIRECT_URI=https://VOTRE-DOMAINE/auth/tiktok/callback
TIKTOK_WEBHOOK_SECRET=

# --- 3. Chiffrement des jetons (obligatoire) ---
# Generez avec : node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TOKEN_ENCRYPTION_KEY=

# --- 4. Page Admin (OBLIGATOIRE : changez le code de demo !) ---
ADMIN_KEY=changez-moi-par-un-code-long-et-secret

# --- 5. Paiement Mobile Money / carte (obligatoire paiements reels) ---
FLW_SECRET_KEY=
CINETPAY_API_KEY=
CINETPAY_SITE_ID=

# --- 5b. SasPay (recommandé RDC/Afrique) ---
SASPAY_SECRET_KEY=
SASPAY_WEBHOOK_SECRET=
SASPAY_COUNTRY=CD
PUBLIC_BASE_URL=http://localhost:3000

# --- 6. Supabase (recommande en production) ---
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- Serveur ---
PORT=3000
